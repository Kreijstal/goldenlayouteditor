{
  "name": "goldenlayout-ace-editor",
  "version": "1.0.0",
  "description": "A simple HTML editor and preview using GoldenLayout and Ace Editor",
  "main": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:povray": "node scripts/test-povray.js",
    "fetch:povray": "node scripts/fetch-povray.js",
    "test:legacy-art": "node scripts/test-legacy-art.js",
    "build": "npm run build:cd5 && npm run build:idml && npm run build:models && npm run build:bundle && npm run build:scientific && npm run build:ifc && npm run build:archive && npm run build:adobe && node scripts/build-viewers.js",
    "build:adobe": "node scripts/build-adobe.js",
    "test:adobe-resources": "node scripts/test-adobe-resources.js",
    "test:adobe-containers": "node scripts/test-adobe-containers.js",
    "build:archive": "node scripts/build-archive.js",
    "test:archive-reader": "node scripts/test-archive-reader.js",
    "build:ifc": "node scripts/build-ifc.js",
    "build:scientific": "node scripts/build-scientific.js",
    "test:scientific": "node scripts/test-scientific.js",
    "build:bundle": "node scripts/build-bundle.js",
    "test:bundle": "node scripts/test-bundle.js",
    "build:models": "node scripts/build-models.js",
    "test:models": "node scripts/test-model-loaders.js",
    "build:idml": "node scripts/build-idml.js",
    "test:idml": "node scripts/test-idml.js",
    "build:wanix": "sh scripts/build-wanix.sh",
    "watch": "node scripts/watch-viewers.js",
    "start": "node server.js",
    "build:cd5": "browserify src/cd5-worker.js -o public/cd5-viewer/worker.js && browserify src/cd5-standalone.js -o public/cd5-viewer/viewer.js",
    "test:cd5": "node scripts/test-cd5.js",
    "test:lazy-viewers": "node scripts/test-lazy-viewers.js",
    "test:imported-viewers": "node scripts/test-imported-viewers.js"
  },
  "keywords": [
    "golden-layout",
    "ace-editor",
    "html",
    "editor",
    "preview"
  ],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@paged-media/introspect-wasm": "0.63.0",
    "ag-psd": "30.2.0",
    "archiver": "^7.0.1",
    "buffer": "6.0.3",
    "comlink": "4.4.2",
    "dompurify": "^3.3.3",
    "express": "^5.0.0",
    "golden-layout": "^2.6.0",
    "h5wasm": "0.10.0",
    "js-yaml": "^5.4.2",
    "jszip": "^3.10.1",
    "libarchive.js": "2.0.2",
    "lzma": "2.3.2",
    "netcdfjs": "3.0.0",
    "node-pty": "^1.1.0",
    "npyjs": "1.0.4",
    "pako": "2.1.0",
    "playwright": "^1.58.2",
    "saxes": "6.0.0",
    "seek-bzip": "2.0.0",
    "three": "0.184.0",
    "tslib": "^2.8.1",
    "web-ifc": "0.0.77",
    "ws": "^8.20.0",
    "xz-decompress": "0.2.3"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "browserify": "^17.0.0",
    "esbuild": "^0.28.1",
    "watchify": "^4.0.0"
  }
}
