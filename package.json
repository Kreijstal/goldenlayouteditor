{
  "name": "goldenlayout-ace-editor",
  "version": "1.0.0",
  "description": "A simple HTML editor and preview using GoldenLayout and Ace Editor",
  "main": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:povray": "node scripts/test-povray.js",
    "fetch:povray": "node scripts/fetch-povray.js",
    "test:legacy-art": "node scripts/test-legacy-art.js",
    "build": "npm run build:cd5 && browserify src/main.js -o public/bundle.js",
    "build:wanix": "sh scripts/build-wanix.sh",
    "watch": "watchify src/main.js -o public/bundle.js -v",
    "start": "node server.js",
    "build:cd5": "browserify src/cd5-worker.js -o public/cd5-viewer/worker.js && browserify src/cd5-standalone.js -o public/cd5-viewer/viewer.js",
    "test:cd5": "node scripts/test-cd5.js"
  },
  "keywords": [
    "golden-layout",
    "ace-editor",
    "html",
    "editor",
    "preview"
  ],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "archiver": "^7.0.1",
    "express": "^5.0.0",
    "golden-layout": "^2.6.0",
    "js-yaml": "^5.4.2",
    "node-pty": "^1.1.0",
    "playwright": "^1.58.2",
    "tslib": "^2.8.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "browserify": "^17.0.0",
    "watchify": "^4.0.0"
  }
}
