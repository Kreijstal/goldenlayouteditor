index 8d8be3e..caab0f8 100644
--- a/lib/embed-api.ts
+++ b/lib/embed-api.ts
@@ -247,4 +247,13 @@ export function initEmbedApi(): void {
   window.addEventListener('load', () => {
     postToParent('document:ready');
   });
+
+  // Saves and edits started inside the editor, for the host page
+  window.addEventListener('document:user-save', (event) => {
+    const file = (event as CustomEvent<File>).detail;
+    postToParent('document:saved', { file, fileName: file.name, userInitiated: true } as EmbedResponsePayload);
+  });
+  window.addEventListener('document:user-modified', () => {
+    postToParent('document:modified');
+  });
 }
