+// pathCommandNames lists the executables in the PATH directories, each name once.
+func pathCommandNames(hc interp.HandlerContext) []string {
+	var names []string
+	seen := map[string]bool{}
+	for _, dir := range filepath.SplitList(hc.Env.Get("PATH").String()) {
+		if dir == "" {
+			continue
+		}
+		if !filepath.IsAbs(dir) {
+			dir = filepath.Join(hc.Dir, dir)
+		}
+		entries, err := os.ReadDir(dir)
+		if err != nil {
+			continue
+		}
+		for _, e := range entries {
+			if seen[e.Name()] {
+				continue
+			}
+			info, err := os.Stat(filepath.Join(dir, e.Name()))
+			if err != nil || info.IsDir() {
+				continue
+			}
+			seen[e.Name()] = true
+			names = append(names, e.Name())
+		}
+	}
+	return names
 }
 
